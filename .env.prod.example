# ─────────────────────────────────────────────────────────────────────────────
#  .env.prod.example — SAFE TO COMMIT (no real secrets, just placeholders)
#
#  This is the TEMPLATE for production secrets.
#
#  How to use:
#    cp .env.prod.example .env.prod    ← fill in real prod values
#    railway variables import .env.prod ← push to Railway in one shot
#
#  .env.prod is in .gitignore — NEVER commit it.
#
#  If migrating platforms:
#    Railway  → railway variables import .env.prod
#    Docker   → docker compose --env-file .env.prod up -d
#    K8s      → kubectl create secret generic app-secrets --from-env-file=.env.prod
#    Fly.io   → fly secrets import < .env.prod
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring Profile (activates application-prod.properties) ───────────────────
SPRING_PROFILES_ACTIVE=prod

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Railway internal (fastest — use this when backend and DB are on same Railway project):
#   DB_URL=jdbc:postgresql://postgres.railway.internal:5432/railway
# Railway public (use if connecting from outside Railway, e.g. local machine):
#   DB_URL=jdbc:postgresql://shinkansen.proxy.rlwy.net:PORT/railway
DB_URL=jdbc:postgresql://postgres.railway.internal:5432/railway
DB_USERNAME=postgres
DB_PASSWORD=your_railway_postgres_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠️  DO NOT change this after first deploy — it invalidates ALL user sessions!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_your_actual_512bit_hex_secret

# ── AI / Groq ─────────────────────────────────────────────────────────────────
# Free key from https://console.groq.com → API Keys (starts with gsk_)
OPENAI_API_KEY=gsk_your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your actual Vercel frontend URL and Railway backend URL here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.up.railway.app,https://your-app.vercel.app

