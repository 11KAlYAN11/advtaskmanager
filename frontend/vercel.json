{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "/api",
      "VITE_BACKEND_URL": "https://advtaskmanager-production-e645.up.railway.app"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://advtaskmanager-production-e645.up.railway.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
