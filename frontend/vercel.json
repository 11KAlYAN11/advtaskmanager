{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "/api"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://16.112.115.98:8080/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
