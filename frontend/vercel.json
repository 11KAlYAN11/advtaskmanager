{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "/api"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "advtaskmanager-production-e645.up.railway.app" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
